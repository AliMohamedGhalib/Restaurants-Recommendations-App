<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= category.name %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1><%= category.name %></h1>
    <% if (user && category.owner.toString() === user._id.toString()) { %>
        <p><a href="/categories/<%= category._id %>/edit">Edit</a></p>

        <p><a href="/categories/<%= category._id %>/delete">Delete</a></p>
    <% } %>
    <p><a href="/categories">Back to all sections</a></p>
</body>
</html>
