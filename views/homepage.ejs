<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>

        <link rel="stylesheet" href="/css/style.css">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">

</head>
<body>
    <%- include('./partials/navbar') %>

    <main>
        <h1>What would you like to do?</h1>

    <p><a href="/search">Search for a Restaurant</a></p>

    <% if (user) { %>
        <p><a href="/restaurants/new">Create a Restaurant</a></p>
        <p><a href="/restaurants/mine">Edit My Restaurants</a></p>
    <% } else { %>
        <p>You need to sign in to create or edit restaurants.</p>
        <p><a href="/auth/sign-in">Sign in</a></p>
        <p><a href="/auth/sign-up">Sign up</a></p>
    <% } %>
    </main>
</body>
</html>