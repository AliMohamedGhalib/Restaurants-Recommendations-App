<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Restaurant</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>Add a New Restaurant</h1>

    <form action="/restaurants" method="post">
        <label for="name">Restaurant Name:</label>
        <input id="name" name="name" type="text" required>
        <label for="hasDineIn">Dine-in:</label>
        <input id="hasDineIn" name="hasDineIn" type="checkbox">

        <label for="hasTakeAway">Take Away:</label>
        <input id="hasTakeAway" name="hasTakeAway" type="checkbox">

        <label for="hasDriveThrough">Drive-Through:</label>
        <input id="hasDriveThrough" name="hasDriveThrough" type="checkbox">

        <label for="priceLevel">Budget:</label>
        <select id="priceLevel" name="priceLevel">
            <option value="2BD and below">2BD and below</option>
            <option value="Above 2BD-4BD">Above 2BD-4BD</option>
            <option value="Above 4BD-6BD">Above 4BD-6BD</option>
            <option value="Above 6BD">Above 6BD</option>
        </select>
        <label>Categories:</label>
        <% for (let oneCategory of categories) { %>
            <label for="<%= oneCategory._id %>"><%= oneCategory.name %>:</label>
            <input id="<%= oneCategory._id %>" name="categories" type="checkbox" value="<%= oneCategory._id %>">
        <% } %>

        <label for="locationLink">Google Maps Link:</label>
        <input id="locationLink" name="locationLink" type="text">

                <label for="image">Image URL:</label>
        <input id="image" name="image" type="text">


        <button>Add Restaurant</button>
    </form>
</body>
</html>
