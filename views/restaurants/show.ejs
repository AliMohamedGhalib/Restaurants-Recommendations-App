<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= restaurant.name %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1><%= restaurant.name %></h1>

    <p>Budget: <%= restaurant.priceLevel %></p>
    <p>Dine-in: <%= restaurant.hasDineIn ? "Yes" : "No" %></p>
    <p>Take Away: <%= restaurant.hasTakeAway ? "Yes" : "No" %></p>
    <p>Drive-Through: <%= restaurant.hasDriveThrough ? "Yes" : "No" %></p>

    <p>Categories:
    <% for (let oneCategory of restaurant.categories) { %>
        <%= oneCategory.name %>
    <% } %>
    </p>

        <% if (restaurant.image) { %>
        <img src="<%= restaurant.image %>" alt="<%= restaurant.name %>" width="300">
    <% } %>

    <% if (restaurant.locationLink) { %>
        <p><a href="<%= restaurant.locationLink %>" target="_blank">Take me to it!</a></p>
    <% } %>
    <% if (user && restaurant.owner.toString() === user._id.toString()) { %>
        <p><a href="/restaurants/<%= restaurant._id %>/edit">Edit</a></p>

        <p><a href="/restaurants/<%= restaurant._id %>/delete">Delete</a></p>
    <% } %>

    <p><a href="/restaurants">Back to all restaurants</a></p>
</body>
</html>
