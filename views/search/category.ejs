<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>Which category?</h1>

    <form action="/search/results" method="post">
        <input type="hidden" name="hasDineIn" value="<%= hasDineIn %>">
        <input type="hidden" name="hasTakeAway" value="<%= hasTakeAway %>">
        <input type="hidden" name="hasDriveThrough" value="<%= hasDriveThrough %>">
        <% for (let level of priceLevels) { %>
            <input type="hidden" name="priceLevel" value="<%= level %>">
        <% } %>
        <% for (let oneCategory of categories) { %>
            <label for="<%= oneCategory._id %>"><%= oneCategory.name %>:</label>
            <input id="<%= oneCategory._id %>" name="category" type="checkbox" value="<%= oneCategory._id %>">
        <% } %>

        <button>Show Results</button>
    </form>
</body>
</html>
