<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>Do you want Drive-Through?</h1>
    <form action="/search/drivethrough" method="post">
        <input type="hidden" name="hasDineIn" value="<%= hasDineIn %>">
        <input type="hidden" name="hasTakeAway" value="<%= hasTakeAway %>">

        <label for="hasDriveThrough">Drive-Through:</label>
        <input id="hasDriveThrough" name="hasDriveThrough" type="checkbox">

        <button>Next</button>
    </form>
</body>
</html>
